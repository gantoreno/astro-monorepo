{
  "name": "astro-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:marketing": "bun run --filter marketing dev",
    "dev:docs": "bun run --filter docs dev",
    "preview": "bun scripts/preview.js",
    "build": "bun run --filter '*' build",
    "build:marketing": "bun run --filter marketing build",
    "build:docs": "bun run --filter docs build",
    "test": "bun run build && bun test"
  }
}
